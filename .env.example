# CAFE CHIRO — environment
#
# The demo runs fully WITHOUT any of these (reservations + News CMS use a
# browser localStorage store). Fill these in only when you connect the
# Supabase production backend described in supabase/migrations/0001_init.sql.

# Public site URL — used for canonical / OpenGraph / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional / production backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin demo gate (client-side demo only — replace with Supabase Auth in prod).
NEXT_PUBLIC_ADMIN_DEMO_PASSCODE=chiro-admin
